{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/mino... run build",
  "outputDirectory": "artifacts/mino/dist/public",
  "build": {
    "env": {
      "PORT": "3000",
      "BASE_PATH": "/",
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
